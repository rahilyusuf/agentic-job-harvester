# =============================================================================
# .gitignore — agentic-job-harvester
# Generated for: Python 3.11+, Google ADK, FastAPI/Uvicorn, LiteLLM, LangFuse,
#                E2B, BigQuery, Pub/Sub, Secret Manager, Cloud Run, Docker,
#                Ruff, mypy, pytest, coverage, python-dotenv
# =============================================================================


# =============================================================================
# SECRETS & CREDENTIALS  ← highest priority: these must NEVER be committed
# =============================================================================

# Local environment files (python-dotenv — used by config/settings.py)
.env
.env.*
# Allow the committed example/template file through (negation must be on its own line)
!.env.example

# GCP service-account credentials & ADC files
# Ignore common service-account naming conventions rather than all *.json
# (avoids accidentally hiding legitimate package.json, tsconfig.json, etc.)
*service_account*.json
*service-account*.json
*serviceaccount*.json
*sa_key*.json
*sa-key*.json
*credentials*.json

# GCP application default credentials (local ADC override)
application_default_credentials.json

# Private keys, certificates, tokens
*.pem
*.p12
*.pfx
*.key
*.crt
*.cer
*.token

# gcloud CLI local state (not repo-specific, but catches accidental copies)
.config/gcloud/

# LiteLLM proxy database (SQLite fallback when no Postgres configured)
litellm.db
proxy_server_config.yaml.local

# Telegram bot token if ever materialised locally
telegram_bot_token.txt


# =============================================================================
# PYTHON — virtual environments
# =============================================================================

.venv/
venv/
env/
.env/          # separate from the dotenv .env file above (directory form)
ENV/
venv.bak/
.python-version


# =============================================================================
# PYTHON — compiled files & caches
# =============================================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging (not used to publish, but keep tidy)
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/


# =============================================================================
# PYTHON — test, coverage & quality tooling
# =============================================================================

# pytest
.pytest_cache/
.cache/
pytestdebug.log

# coverage.py  (pyproject.toml [tool.coverage] is committed; reports are not)
.coverage
.coverage.*
coverage.xml
htmlcov/

# mypy  (pyproject.toml [tool.mypy] is committed; cache is not)
.mypy_cache/
*.pyi.bak

# Ruff cache  (pyproject.toml [tool.ruff] is committed; cache is not)
.ruff_cache/

# Type-checking stubs generated at runtime
typings/


# =============================================================================
# GOOGLE ADK — session state & local runner artefacts
# =============================================================================

# ADK local dev runner stores session state in SQLite
.adk/
adk_sessions/
sessions.db
*.adk.db

# ADK web UI build output (generated by `adk web`)
.adk_web/


# =============================================================================
# GOOGLE CLOUD / GCP tooling
# =============================================================================

# gcloud SDK local config directories that may land in project roots
.gcloud/

# Terraform (if added later — infra/ contains Dockerfiles/cloudbuild.yaml today)
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/
*.tfvars              # may contain secrets
!*.tfvars.example

# Cloud Build local trigger results
.cloudbuild-local/


# =============================================================================
# DOCKER — local/generated artefacts only
# NOTE: Dockerfiles and cloudbuild.yaml in infra/ ARE intentionally committed.
# =============================================================================

# Local override compose files (if added during dev)
docker-compose.override.yml
docker-compose.local.yml

# Docker build cache exported to disk
.docker-cache/


# =============================================================================
# E2B — sandbox artefacts
# =============================================================================

# E2B SDK caches downloaded sandbox images locally
.e2b/
e2b_cache/


# =============================================================================
# LANGFUSE — local telemetry cache / export files
# =============================================================================

langfuse_export/
langfuse_local.db


# =============================================================================
# FASTAPI / UVICORN — runtime artefacts
# =============================================================================

# uvicorn access logs if redirected to disk
uvicorn.log
access.log


# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================

*.log
*.log.*
logs/
tmp/
temp/
.tmp/


# =============================================================================
# LOCAL DATABASES & STATE FILES
# =============================================================================

*.db
*.sqlite
*.sqlite3


# =============================================================================
# IDE & EDITOR — VS Code
# NOTE: .vscode/settings.json, .vscode/extensions.json are often committed.
#       Ignore only local/personal overrides.
# =============================================================================

.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace
# Allow: .vscode/extensions.json (recommended extensions list — useful for team)
!.vscode/extensions.json


# =============================================================================
# IDE & EDITOR — JetBrains (PyCharm, IntelliJ, etc.)
# =============================================================================

.idea/
*.iml
*.iws
*.ipr
out/


# =============================================================================
# IDE & EDITOR — Antigravity
# =============================================================================

.gemini/
.antigravity/


# =============================================================================
# OS-GENERATED FILES
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Byte-order mark files (Windows text editors)
*.bom

# Jupyter notebooks (not used in this project, but common in ML repos)
.ipynb_checkpoints/

# Downloaded / fetched artefacts from scripts/
scripts/downloads/
scripts/__output__/

# Profiling output
*.prof
*.pstats
